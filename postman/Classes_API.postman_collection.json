{
  "info": {
    "name": "Classes API (unified Class master)",
    "description": "Test collection for the unified `classes` master table that replaces product_classes / product_classes_eu.\n\nTwo surfaces:\n1. Portal master CRUD (generic, driven by MASTER_TABLES) — base /api/v1/master/classes\n2. NetSuite cost-sheet sync (upsert by netsuiteInternalId) — base /api/v1/netsuite/cost-sheet/classes\n\nSet {{baseUrl}} to your server. {{id}} = local PK, {{nsId}} = NetSuite internal id.\nThe Create requests auto-capture the returned id/nsId into collection variables.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000", "type": "string" },
    { "key": "id", "value": "1", "type": "string" },
    { "key": "nsId", "value": "1001", "type": "string" },
    { "key": "token", "value": "", "type": "string" },
    { "key": "estimateId", "value": "", "type": "string" },
    { "key": "lineItemId", "value": "", "type": "string" },
    { "key": "classId", "value": "1", "type": "string" }
  ],
  "item": [
    {
      "name": "Master API (portal)",
      "item": [
        {
          "name": "Create class (POST /master/classes)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "if (res && res.id) { pm.collectionVariables.set('id', res.id); }",
                  "pm.test('status 201', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Accessories\",\n  \"parentClass\": \"Soft Goods\",\n  \"subsidiaries\": \"TwelveUSA : TwelveHK, TwelveUSA : TwelveUK\",\n  \"includeChildren\": true,\n  \"usHtsCode\": \"4202.92\",\n  \"usDutyRate\": \"5.000\",\n  \"show\": false,\n  \"euHtsImport\": \"4202920000\",\n  \"euHtsExport\": \"4202920000\",\n  \"euDutyRate\": \"3.700\",\n  \"notes\": \"Created via Postman\",\n  \"classPlanningCategory\": \"Bags\",\n  \"nspbClassPlanningCategory\": \"Bags & Packs\",\n  \"chinaDutyRate\": \"20.000\",\n  \"cambodiaDutyRate\": \"0.000\",\n  \"taiwanDutyRate\": \"6.500\",\n  \"thailandDutyRate\": \"5.000\",\n  \"vietnamDutyRate\": \"8.000\",\n  \"chinaTariffRate\": \"25.000\",\n  \"hkTariffRate\": \"0.000\",\n  \"taiwanTariffRate\": \"0.000\",\n  \"vietnamTariffRate\": \"0.000\",\n  \"cambodiaTariffRate\": \"0.000\",\n  \"thailandTariffRate\": \"0.000\",\n  \"isEu\": \"Yes\",\n  \"euHtsCode\": \"4202.92.00\",\n  \"chinaDutyRateEu\": \"20.000\",\n  \"cambodiaDutyRateEu\": \"0.000\",\n  \"taiwanDutyRateEu\": \"6.500\",\n  \"thailandDutyRateEu\": \"5.000\",\n  \"vietnamDutyRateEu\": \"8.000\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/master/classes",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "master", "classes"]
            },
            "description": "Generic master create. Body uses camelCase column props; all fields optional except name."
          }
        },
        {
          "name": "List all classes (GET /master/classes)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/master/classes",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "master", "classes"]
            },
            "description": "Bespoke endpoint: returns ALL rows (active + inactive) with every field, ordered by name."
          }
        },
        {
          "name": "Get class by id (GET /master/classes/:id)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/master/classes/{{id}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "master", "classes", "{{id}}"]
            }
          }
        },
        {
          "name": "Update class (PATCH /master/classes/:id)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Accessories (updated)\",\n  \"usDutyRate\": \"6.250\",\n  \"notes\": \"Updated via Postman\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/master/classes/{{id}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "master", "classes", "{{id}}"]
            }
          }
        },
        {
          "name": "Inactivate class (PATCH /master/classes/:id/status)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"is_active\": false\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/master/classes/{{id}}/status",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "master", "classes", "{{id}}", "status"]
            },
            "description": "Generic status toggle. Body key is is_active (snake_case)."
          }
        },
        {
          "name": "Activate class (PATCH /master/classes/:id/status)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"is_active\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/master/classes/{{id}}/status",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "master", "classes", "{{id}}", "status"]
            }
          }
        }
      ]
    },
    {
      "name": "NetSuite Cost-Sheet Sync",
      "item": [
        {
          "name": "Upsert class (POST /cost-sheet/classes)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "if (res && res.netsuiteInternalId) { pm.collectionVariables.set('nsId', res.netsuiteInternalId); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"netsuiteInternalId\": \"{{nsId}}\",\n  \"name\": \"Accessories\",\n  \"custrecord_parentclass\": \"Soft Goods\",\n  \"custrecord_ushts_code\": \"4202.92\",\n  \"custrecord_chinaduty_rate\": \"20\",\n  \"custrecord_cambodiaduty_rate\": \"0\",\n  \"custrecord_taiwanduty_rate\": \"6.5\",\n  \"custrecord_thailandduty_rate\": \"5\",\n  \"custrecord_vietnamduty_rate\": \"8\",\n  \"custrecord_chinatariff_rate\": \"25\",\n  \"custrecord_hktariff_rate\": \"0\",\n  \"custrecord_taiwantariff_rate\": \"0\",\n  \"custrecord_vietnamtariff_rate\": \"0\",\n  \"custrecord_cambodiatariff_rate\": \"0\",\n  \"custrecord_thailandtariff_rate\": \"0\",\n  \"subsidiaries\": \"TwelveUSA : TwelveHK\",\n  \"includeChildren\": true,\n  \"usDutyRate\": \"5\",\n  \"show\": false,\n  \"euHtsImport\": \"4202920000\",\n  \"euHtsExport\": \"4202920000\",\n  \"euDutyRate\": \"3.7\",\n  \"notes\": \"NS sync test\",\n  \"classPlanningCategory\": \"Bags\",\n  \"nspbClassPlanningCategory\": \"Bags & Packs\",\n  \"isEu\": \"Yes\",\n  \"euHtsCode\": \"4202.92.00\",\n  \"chinaDutyRateEu\": \"20\",\n  \"cambodiaDutyRateEu\": \"0\",\n  \"taiwanDutyRateEu\": \"6.5\",\n  \"thailandDutyRateEu\": \"5\",\n  \"vietnamDutyRateEu\": \"8\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/netsuite/cost-sheet/classes",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "netsuite", "cost-sheet", "classes"]
            },
            "description": "Idempotent upsert on netsuiteInternalId. Known fields use custrecord_* names; newer fields use camelCase props (NS field ids TBD). Returns _action: created|updated."
          }
        },
        {
          "name": "List active classes (GET /cost-sheet/classes)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/netsuite/cost-sheet/classes",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "netsuite", "cost-sheet", "classes"]
            }
          }
        },
        {
          "name": "Get class by nsId (GET /cost-sheet/classes/:nsId)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/netsuite/cost-sheet/classes/{{nsId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "netsuite", "cost-sheet", "classes", "{{nsId}}"]
            }
          }
        },
        {
          "name": "Update class (PUT /cost-sheet/classes/:nsId)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Accessories (NS updated)\",\n  \"custrecord_chinaduty_rate\": \"22\",\n  \"euDutyRate\": \"4.0\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/netsuite/cost-sheet/classes/{{nsId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "netsuite", "cost-sheet", "classes", "{{nsId}}"]
            }
          }
        },
        {
          "name": "Set status (PUT /cost-sheet/classes/:nsId/status)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"isActive\": false\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/netsuite/cost-sheet/classes/{{nsId}}/status",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "netsuite", "cost-sheet", "classes", "{{nsId}}", "status"]
            },
            "description": "NetSuite status toggle. Body key is isActive (camelCase) — differs from the master route's is_active."
          }
        }
      ]
    },
    {
      "name": "Line-item ↔ Class relation",
      "description": "Exercises the estimate_line_items.class_id FK end to end.\n\nFlow: set classId on a line (portal) -> trigger the outbound NetSuite sync -> NetSuite returns resolvedClassIds per line -> portal writes them back into estimate_line_items.class_id (same read-response-then-write-back pattern as adjustedPipelineAmountNS).\n\nSet {{token}} (Bearer JWT — these estimate routes require auth), {{estimateId}} (a real estimate id), and {{classId}} (a real classes.id, e.g. from the Master API folder). Create captures the new line id into {{lineItemId}}.",
      "item": [
        {
          "name": "Create line item with classId (POST /estimates/:estimateId/line-items)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "if (res && res.id) { pm.collectionVariables.set('lineItemId', res.id); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}", "type": "text" },
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"shortDescription\": \"Class relation test line\",\n  \"quantity\": \"10\",\n  \"sellPricePerUnit\": \"5.00\",\n  \"countryOfDest\": \"US\",\n  \"classId\": {{classId}}\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/estimates/{{estimateId}}/line-items",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "estimates", "{{estimateId}}", "line-items"]
            },
            "description": "Portal line-item create. classId is the local classes.id (the new unified Class FK). Persists to estimate_line_items.class_id."
          }
        },
        {
          "name": "Update line item classId (PATCH /estimates/:estimateId/line-items/:id)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}", "type": "text" },
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"classId\": {{classId}}\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/estimates/{{estimateId}}/line-items/{{lineItemId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "estimates", "{{estimateId}}", "line-items", "{{lineItemId}}"]
            }
          }
        },
        {
          "name": "Resync estimate → class write-back (POST /estimates/:id/resync)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}", "type": "text" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/estimates/{{estimateId}}/resync",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "estimates", "{{estimateId}}", "resync"]
            },
            "description": "Re-runs the outbound NetSuite sync. If the suitelet returns resolvedClassIds (per line, keyed by 1-based line number, or a positional array), the portal writes each into that line's class_id. Requires NS_SUITELET_URL configured and reachable."
          }
        },
        {
          "name": "Verify line items (GET /estimates/:estimateId/line-items)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}", "type": "text" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/estimates/{{estimateId}}/line-items",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "estimates", "{{estimateId}}", "line-items"]
            },
            "description": "Confirm classId is set on the line(s) — either the value you sent, or the value NetSuite resolved and wrote back after resync."
          }
        }
      ]
    }
  ]
}
