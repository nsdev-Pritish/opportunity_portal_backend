{
  "info": {
    "name": "Estimates — GET Filter APIs",
    "description": "Two APIs for the Estimates filter panel.\n\n1. Document Numbers dropdown\n2. Get estimates — pass whichever filter the user selected (document number, department, customer, project name, etc.). All params are optional and independent.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000", "type": "string" }
  ],
  "item": [
    {
      "name": "1. GET Document Numbers Dropdown",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/estimates/document-numbers",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "estimates", "document-numbers"]
        },
        "description": "Returns lightweight list [{id, documentNumber, projectName, customerName, status}] to populate the document number dropdown.\n\nNo params needed — returns all active estimates."
      },
      "response": [
        {
          "name": "200 OK",
          "status": "OK",
          "code": 200,
          "header": [{ "key": "Content-Type", "value": "application/json" }],
          "body": "[\n  { \"id\": 1, \"documentNumber\": \"EST-0001\", \"projectName\": \"Summer Collection\", \"customerName\": \"Acme Corp\", \"status\": \"In Progress\" },\n  { \"id\": 2, \"documentNumber\": \"EST-0002\", \"projectName\": \"Winter Line\",      \"customerName\": \"Beta LLC\",  \"status\": \"Won\" }\n]"
        }
      ]
    },
    {
      "name": "2. GET Estimates by Selected Filter",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/estimates/search?page=1&limit=20",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "estimates", "search"],
          "query": [
            {
              "key": "page",
              "value": "1",
              "description": "Page number (default 1)"
            },
            {
              "key": "limit",
              "value": "20",
              "description": "Records per page, max 100 (default 20)"
            },
            {
              "key": "estimateId",
              "value": "",
              "description": "← Enable this when user selects a Document Number from dropdown (use id from API 1). Returns FULL estimate with all line items + freight groups instead of a summary list.",
              "disabled": true
            },
            {
              "key": "departmentId",
              "value": "",
              "description": "← Enable this when user selects a Department",
              "disabled": true
            },
            {
              "key": "departmentName",
              "value": "",
              "description": "Department name partial match (alternative to departmentId)",
              "disabled": true
            },
            {
              "key": "customerId",
              "value": "",
              "description": "← Enable this when user selects a Customer",
              "disabled": true
            },
            {
              "key": "customerName",
              "value": "",
              "description": "Customer name partial match (alternative to customerId)",
              "disabled": true
            },
            {
              "key": "projectNameId",
              "value": "",
              "description": "← Enable this when user selects a Project Name",
              "disabled": true
            },
            {
              "key": "projectName",
              "value": "",
              "description": "Project name partial match (alternative to projectNameId)",
              "disabled": true
            },
            {
              "key": "salesRepId",
              "value": "",
              "description": "← Enable this when user selects a Sales Rep",
              "disabled": true
            },
            {
              "key": "salesRepName",
              "value": "",
              "description": "Sales rep name partial match (alternative to salesRepId)",
              "disabled": true
            },
            {
              "key": "opsPartnerId",
              "value": "",
              "description": "← Enable this when user selects an OPS Partner",
              "disabled": true
            },
            {
              "key": "opsPartnerName",
              "value": "",
              "description": "OPS partner name partial match (alternative to opsPartnerId)",
              "disabled": true
            },
            {
              "key": "businessVerticalId",
              "value": "",
              "description": "← Enable this when user selects a Business Vertical",
              "disabled": true
            },
            {
              "key": "businessVerticalName",
              "value": "",
              "description": "Business vertical name partial match",
              "disabled": true
            },
            {
              "key": "statuses",
              "value": "",
              "description": "← Enable this when user selects a Status. Comma-separated e.g. In Progress,Won,Lost",
              "disabled": true
            },
            {
              "key": "productDeveloperId",
              "value": "",
              "description": "← Enable this when user selects a Product Developer",
              "disabled": true
            },
            {
              "key": "productDeveloperName",
              "value": "",
              "description": "Product developer name partial match",
              "disabled": true
            },
            {
              "key": "likelyToCloseId",
              "value": "",
              "description": "← Enable this when user selects a Likely To Close value",
              "disabled": true
            },
            {
              "key": "likelyToCloseName",
              "value": "",
              "description": "Likely-to-close name partial match",
              "disabled": true
            },
            {
              "key": "expectedCloseDateFrom",
              "value": "",
              "description": "← Expected Close Date › From (YYYY-MM-DD)",
              "disabled": true
            },
            {
              "key": "expectedCloseDateTo",
              "value": "",
              "description": "← Expected Close Date › To (YYYY-MM-DD)",
              "disabled": true
            },
            {
              "key": "dateOfEntryFrom",
              "value": "",
              "description": "← Date of Entry › From (YYYY-MM-DD)",
              "disabled": true
            },
            {
              "key": "dateOfEntryTo",
              "value": "",
              "description": "← Date of Entry › To (YYYY-MM-DD)",
              "disabled": true
            }
          ]
        },
        "description": "Single API that handles all filter selections.\n\n--- RESPONSE BEHAVIOUR ---\n\n• `estimateId` provided → returns FULL single estimate (header + lineItems[] with nested components[] + freightGroups[])\n• Any other filter       → returns paginated summary LIST of matching estimates\n\n--- WHICH PARAM TO ENABLE ---\n\n• User selects Document Number  → enable `estimateId` (id from API 1)\n• User selects Department       → enable `departmentId` or `departmentName`\n• User selects Customer         → enable `customerId` or `customerName`\n• User selects Project Name     → enable `projectNameId` or `projectName`\n• User selects Sales Rep        → enable `salesRepId` or `salesRepName`\n• User selects OPS Partner      → enable `opsPartnerId` or `opsPartnerName`\n• User selects Business Vertical→ enable `businessVerticalId`\n• User selects Status           → enable `statuses` (comma-separated e.g. In Progress,Won)\n• User selects Product Developer→ enable `productDeveloperId`\n• User selects Likely To Close  → enable `likelyToCloseId`\n• User sets date range          → enable `expectedCloseDateFrom` + `expectedCloseDateTo`\n\nMultiple non-estimateId params can be combined."
      },
      "response": [
        {
          "name": "200 OK — by Document Number (estimateId=1)",
          "status": "OK",
          "code": 200,
          "header": [{ "key": "Content-Type", "value": "application/json" }],
          "body": "{\n  \"data\": [\n    {\n      \"id\": 1,\n      \"documentNumber\": \"EST-0001\",\n      \"projectName\": \"Summer Collection\",\n      \"status\": \"In Progress\",\n      \"customerName\": \"Acme Corp\",\n      \"departmentName\": \"Apparel\",\n      \"businessVerticalName\": \"Retail\",\n      \"salesRepName\": \"John Smith\",\n      \"expectedCloseDate\": \"2026-06-30\",\n      \"projectedTotalAmt\": \"50000.00\",\n      \"createdAt\": \"2026-05-01T10:00:00Z\"\n    }\n  ],\n  \"total\": 1,\n  \"page\": 1,\n  \"limit\": 20\n}"
        },
        {
          "name": "200 OK — by Department (departmentId=44)",
          "status": "OK",
          "code": 200,
          "header": [{ "key": "Content-Type", "value": "application/json" }],
          "body": "{\n  \"data\": [\n    { \"id\": 1, \"documentNumber\": \"EST-0001\", \"departmentName\": \"Apparel\", \"customerName\": \"Acme Corp\" },\n    { \"id\": 3, \"documentNumber\": \"EST-0003\", \"departmentName\": \"Apparel\", \"customerName\": \"Gamma Inc\" }\n  ],\n  \"total\": 2,\n  \"page\": 1,\n  \"limit\": 20\n}"
        },
        {
          "name": "200 OK — by Customer (customerId=12)",
          "status": "OK",
          "code": 200,
          "header": [{ "key": "Content-Type", "value": "application/json" }],
          "body": "{\n  \"data\": [\n    { \"id\": 1, \"documentNumber\": \"EST-0001\", \"customerName\": \"Acme Corp\", \"status\": \"In Progress\" },\n    { \"id\": 5, \"documentNumber\": \"EST-0005\", \"customerName\": \"Acme Corp\", \"status\": \"Won\" }\n  ],\n  \"total\": 2,\n  \"page\": 1,\n  \"limit\": 20\n}"
        }
      ]
    }
  ]
}
