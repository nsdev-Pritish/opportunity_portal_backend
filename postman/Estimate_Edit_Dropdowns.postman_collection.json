            "url": {
              "raw": "{{baseUrl}}/api/v1/netsuite/estimate-statuses/301",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "netsuite", "estimate-statuses", "301"]
            },
            "description": "Returns a single estimate status by its NetSuite internal ID."
          },
          "response": []
        },
