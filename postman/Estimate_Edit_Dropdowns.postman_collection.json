              "raw": "{\n  \"netsuiteInternalId\": \"301\",\n  \"name\": \"In Progress\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/netsuite/estimate-statuses",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "netsuite", "estimate-statuses"]
            },
