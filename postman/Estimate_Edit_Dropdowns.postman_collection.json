            },
            "description": "Creates or upserts a client pursuit alternative."
          },
          "response": [
            {
              "name": "201 Created",
              "status": "Created",
              "code": 201,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{ \"id\": 1, \"name\": \"Competitor A\", \"netsuiteInternalId\": \"201\", \"isActive\": true, \"_action\": \"created\" }"
            }
          ]
        },
        {
          "name": "PUT Update Client Pursuit Alternative",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "X-API-Key",     "value": "{{apiKey}}" },
              { "key": "Content-Type",  "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Competitor A — Updated\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/netsuite/client-pursuit-alternatives/201",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "netsuite", "client-pursuit-alternatives", "201"]
            },
            "description": "Updates an existing client pursuit alternative by its NetSuite internal ID."
          },
          "response": []
        },
        {
          "name": "PUT Toggle Active Status",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "X-API-Key",     "value": "{{apiKey}}" },
              { "key": "Content-Type",  "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"isActive\": false\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/netsuite/client-pursuit-alternatives/201/status",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "netsuite", "client-pursuit-alternatives", "201", "status"]
            },
            "description": "Activate or deactivate a client pursuit alternative."
          },
          "response": []
        }
      ]
    },

    {
      "name": "3. Estimate Statuses",
      "item": [
        {
          "name": "GET All Estimate Statuses",
          "request": {
            "method": "GET",
            "header": [{ "key": "X-API-Key", "value": "{{apiKey}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/netsuite/estimate-statuses",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "netsuite", "estimate-statuses"]
            },
            "description": "Returns all active estimate statuses ordered by name."
          },
          "response": [
            {
              "name": "200 OK",
              "status": "OK",
              "code": 200,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "[\n  { \"id\": 1, \"name\": \"In Progress\", \"netsuiteInternalId\": \"301\", \"isActive\": true },\n  { \"id\": 2, \"name\": \"Won\",         \"netsuiteInternalId\": \"302\", \"isActive\": true },\n  { \"id\": 3, \"name\": \"Lost\",        \"netsuiteInternalId\": \"303\", \"isActive\": true }\n]"
            }
          ]
        },
