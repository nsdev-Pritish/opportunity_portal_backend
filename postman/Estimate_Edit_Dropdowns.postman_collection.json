{
  "info": {
    "name": "Estimate Edit Dropdowns",
    "description": "CRUD APIs for the three estimate edit/update dropdowns:\n1. Closed Lost Reason\n2. Client Pursuit Alternative\n3. Status (Estimate Status)\n\nAll endpoints live under /api/v1/netsuite/ and require the X-API-Key header.\nPOST is an upsert — if the netsuiteInternalId already exists it updates, otherwise creates.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000", "type": "string" },
    { "key": "apiKey",  "value": "your-api-key-here",    "type": "string" }
  ],
  "item": [

    {
      "name": "1. Closed Lost Reasons",
      "item": [
        {
          "name": "GET All Closed Lost Reasons",
          "request": {
            "method": "GET",
            "header": [{ "key": "X-API-Key", "value": "{{apiKey}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/netsuite/closed-lost-reasons",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "netsuite", "closed-lost-reasons"]
            },
            "description": "Returns all active closed lost reasons ordered by name."
          },
          "response": [
            {
              "name": "200 OK",
              "status": "OK",
              "code": 200,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "[\n  { \"id\": 1, \"name\": \"Price\", \"netsuiteInternalId\": \"101\", \"isActive\": true },\n  { \"id\": 2, \"name\": \"Timeline\", \"netsuiteInternalId\": \"102\", \"isActive\": true }\n]"
            }
          ]
        },
        {
          "name": "GET Closed Lost Reason by NS ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "X-API-Key", "value": "{{apiKey}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/netsuite/closed-lost-reasons/101",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "netsuite", "closed-lost-reasons", "101"]
            },
            "description": "Returns a single closed lost reason by its NetSuite internal ID."
          },
          "response": [
            {
              "name": "200 OK",
              "status": "OK",
              "code": 200,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{ \"id\": 1, \"name\": \"Price\", \"netsuiteInternalId\": \"101\", \"isActive\": true }"
            }
          ]
        },
        {
          "name": "POST Create / Upsert Closed Lost Reason",
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-API-Key",     "value": "{{apiKey}}" },
              { "key": "Content-Type",  "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"netsuiteInternalId\": \"101\",\n  \"name\": \"Price\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/netsuite/closed-lost-reasons",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "netsuite", "closed-lost-reasons"]
            },
            "description": "Creates a new closed lost reason. If the netsuiteInternalId already exists, updates the name instead (upsert). Returns 201 on create, 200 on update."
          },
          "response": [
            {
              "name": "201 Created",
              "status": "Created",
              "code": 201,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{ \"id\": 1, \"name\": \"Price\", \"netsuiteInternalId\": \"101\", \"isActive\": true, \"_action\": \"created\" }"
            }
          ]
        },
        {
          "name": "PUT Update Closed Lost Reason",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "X-API-Key",     "value": "{{apiKey}}" },
              { "key": "Content-Type",  "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Price — Updated\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/netsuite/closed-lost-reasons/101",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "netsuite", "closed-lost-reasons", "101"]
            },
            "description": "Updates an existing closed lost reason by its NetSuite internal ID."
          },
          "response": []
        },
        {
          "name": "PUT Toggle Active Status",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "X-API-Key",     "value": "{{apiKey}}" },
              { "key": "Content-Type",  "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"isActive\": false\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/netsuite/closed-lost-reasons/101/status",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "netsuite", "closed-lost-reasons", "101", "status"]
            },
            "description": "Activate or deactivate a closed lost reason. Deactivated records are hidden from the GET list."
          },
          "response": []
        }
      ]
    },

