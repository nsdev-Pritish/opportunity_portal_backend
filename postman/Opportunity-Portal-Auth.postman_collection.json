{
  "info": {
    "name": "Opportunity Portal — NetSuite Sync, Auth & Estimate Access",
    "description": "Covers the new NetSuite employee→user sync, login, optional password change, forgot/reset password, profile, and NetSuite-Internal-ID-based Estimate access control.\n\nNote: changing the default password is available but NOT enforced — `mustChangePassword` is purely informational (returned by Login/Profile so the frontend can nudge the user), and estimates/master/upload never block on it.\n\nSuggested run order:\n1. NetSuite Sync → Employee Push (Simple) — creates a Portal login for a fresh employee.\n2. Auth → Login (Synced Employee) — logs in with the default password; note `mustChangePassword: true`.\n3. Estimates → List / Search — works immediately with the default-password token (only estimates this user is authorized to see).\n4. Auth → Change Password — optional; completes the change if the user chooses to.\n5. Auth → Forgot Password / Reset Password — exercised independently (see notes on those requests; forgot-password requires real SMTP creds in `.env` to actually deliver the email).\n\nAll requests use collection variables set by `{{baseUrl}}` and `{{token}}`. The Login request's test script auto-saves the token, mustChangePassword flag, and netsuiteInternalId into collection variables so later requests just work.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000", "type": "string" },
    { "key": "token", "value": "", "type": "string" },
    { "key": "adminToken", "value": "", "type": "string" },
    { "key": "testEmail", "value": "test.sync.999001@example.com", "type": "string" },
    { "key": "testNsId", "value": "999001", "type": "string" },
    { "key": "defaultPassword", "value": "password@123", "type": "string" },
    { "key": "newPassword", "value": "NewPass123!", "type": "string" },
    { "key": "resetToken", "value": "", "type": "string" },
    { "key": "nsApiKey", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "1. NetSuite Sync",
      "item": [
        {
          "name": "Employee Push (Simple) — creates/updates Portal user",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-API-Key", "value": "{{nsApiKey}}", "disabled": true, "description": "Currently unused — apiKeyAuth is commented out on /api/v1/netsuite/* routes. Enable this header once that's re-enabled." }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/netsuite/employees",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "netsuite", "employees"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"netsuiteInternalId\": \"{{testNsId}}\",\n  \"firstName\": \"Test\",\n  \"lastName\": \"Sync\",\n  \"email\": \"{{testEmail}}\",\n  \"roles\": []\n}"
            },
            "description": "Simulates NetSuite's afterSubmit push for an Employee record. On create, a Portal `users` row is upserted via userSync.service.ts: bcrypt hash of the default password (password@123), mustChangePassword=true, netsuiteInternalId linked."
          }
        },
        {
          "name": "Employee Push (List/Full variant)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/netsuite/list/employees",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "netsuite", "list", "employees"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"netsuiteInternalId\": \"999002\",\n  \"name\": \"List Sync\",\n  \"jobTitle\": \"Account Manager\",\n  \"salesRep\": true,\n  \"email\": \"list.sync.999002@example.com\"\n}"
            },
            "description": "Fuller employee record variant (also resolves currency/subsidiary/department NS ids). Same user-sync behavior as the simple endpoint."
          }
        },
        {
          "name": "Employee Status Update (deactivate → also deactivates the Portal login)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/netsuite/employees/{{testNsId}}/status",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "netsuite", "employees", "{{testNsId}}", "status"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"isActive\": false\n}"
            },
            "description": "Deactivating the employee in NetSuite mirrors isActive=false onto the linked users row, which blocks login (see Auth → Login, isActive check)."
          }
        }
      ]
    },
    {
      "name": "2. Auth",
      "item": [
        {
          "name": "Login (Synced Employee)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.token) {",
                  "    pm.collectionVariables.set('token', body.token);",
                  "    pm.collectionVariables.set('mustChangePassword', body.mustChangePassword);",
                  "    console.log('Saved token. mustChangePassword =', body.mustChangePassword);",
                  "}",
                  "pm.test('Login succeeded', () => pm.response.code === 200);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "login"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{defaultPassword}}\"\n}"
            },
            "description": "Run this right after the Employee Push request. Response includes `mustChangePassword: true` on first login. The test script auto-saves the JWT into {{token}}.\n\nAfter you run Change Password, re-run this with {{newPassword}} instead to get a fresh token with mustChangePassword=false."
          }
        },
        {
          "name": "Me (basic identity)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "me"]
            }
          }
        },
        {
          "name": "Profile (identity + linked NetSuite employee info)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/profile",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "profile"]
            },
            "description": "Not gated by requirePasswordChanged — reachable even before the forced password change."
          }
        },
        {
          "name": "Change Password",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/change-password",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "change-password"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currentPassword\": \"{{defaultPassword}}\",\n  \"newPassword\": \"{{newPassword}}\"\n}"
            },
            "description": "Optional — there's no forced gate requiring this. Re-run Login afterward to get a token reflecting mustChangePassword=false."
          }
        },
        {
          "name": "Forgot Password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/forgot-password",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "forgot-password"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{testEmail}}\"\n}"
            },
            "description": "Always returns a generic 200 message, even for unknown emails (no user enumeration). Requires real SMTP_* creds in .env to actually deliver an email — with the placeholder creds still in .env this will fail server-side (500) after storing the reset token, since sendPasswordResetEmail() throws on send failure. Fill in real SMTP credentials to test the full email path."
          }
        },
        {
          "name": "Reset Password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/reset-password",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "reset-password"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"{{resetToken}}\",\n  \"newPassword\": \"{{newPassword}}\"\n}"
            },
            "description": "Paste the raw token from the reset-link email into {{resetToken}}. Single-use: a second attempt with the same token returns 400 VALIDATION_ERROR (\"Invalid or expired reset link\")."
          }
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/refresh",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "refresh"]
            },
            "description": "Re-signs a fresh token with current DB state — useful right after Change Password without a full re-login."
          }
        },
        {
          "name": "Register (admin-only — no public sign-up)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "register"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"manual.admin.created@example.com\",\n  \"password\": \"SomePassword123!\",\n  \"firstName\": \"Manual\",\n  \"lastName\": \"Account\"\n}"
            },
            "description": "Requires a token for a user with role='admin' in {{adminToken}} — there's no public sign-up per spec. Without an admin token this returns 401."
          }
        }
      ]
    },
    {
      "name": "3. Estimates (access-controlled)",
      "item": [
        {
          "name": "List Estimates",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/estimates?page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "estimates"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" }
              ]
            },
            "description": "Works right away with the default-password token — password change is optional, not enforced. Returns only estimates where this user is the creator, sales rep, ops partner, or product developer (matched via netsuiteInternalId)."
          }
        },
        {
          "name": "Search Estimates (advanced filters)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/estimates/search?page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "estimates", "search"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" }
              ]
            },
            "description": "Same access filter as List Estimates, plus every existing UI filter (customerId, salesRepId, statuses, etc.) as query params."
          }
        },
        {
          "name": "Document Numbers (dropdown)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/estimates/document-numbers",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "estimates", "document-numbers"]
            }
          }
        },
        {
          "name": "Get Estimate by ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/estimates/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "estimates", "1"]
            },
            "description": "Replace 1 with a real estimate id. Returns 404 both when the id doesn't exist AND when it exists but this user isn't authorized to see it (deliberately indistinguishable)."
          }
        }
      ]
    },
    {
      "name": "4. Re-enabled Auth Checks",
      "item": [
        {
          "name": "Master Dropdowns — no token (expect 401)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/master/dropdowns",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "master", "dropdowns"]
            }
          }
        },
        {
          "name": "Upload File — no token (expect 401)",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/v1/upload/file",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "upload", "file"]
            }
          }
        }
      ]
    }
  ]
}
