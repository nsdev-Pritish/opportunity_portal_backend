{
  "info": {
    "name": "Edit Estimates Dropdowns & Product Class EU",
    "description": "GET APIs for estimateStatuses, clientPursuitAlternatives, closedLostReasons, and productClassesEu via /api/v1/master route",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Estimate Statuses",
      "item": [
        {
          "name": "List all active Estimate Statuses",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/master/estimate_statuses",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "master", "estimate_statuses"]
            },
            "description": "Returns all active estimate statuses ordered by name. Fields: id, name, stage, probability, netsuiteInternalId, isActive, createdAt, updatedAt"
          },
          "response": [
            {
              "name": "200 OK – Example",
              "status": "OK",
              "code": 200,
              "body": "[\n  {\n    \"id\": 1,\n    \"name\": \"In Progress\",\n    \"stage\": \"Proposal\",\n    \"probability\": \"25.00\",\n    \"netsuiteInternalId\": \"1\",\n    \"isActive\": true,\n    \"source\": \"netsuite\",\n    \"syncStatus\": \"synced\",\n    \"createdAt\": \"2025-01-01T00:00:00.000Z\",\n    \"updatedAt\": \"2025-01-01T00:00:00.000Z\"\n  }\n]"
            }
          ]
        },
        {
          "name": "Get single Estimate Status by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/master/estimate_statuses/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "master", "estimate_statuses", "1"]
            },
            "description": "Returns a single estimate status by its internal database ID."
          },
          "response": []
        }
      ]
    },
