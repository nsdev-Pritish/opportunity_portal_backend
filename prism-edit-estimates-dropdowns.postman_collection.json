            },
            "description": "Returns all active EU product classes ordered by name. Fields: id, name, parentClass, classCode, euHtsCode, chinaDutyRate, cambodiaDutyRate, taiwanDutyRate, thailandDutyRate, vietnamDutyRate, netsuiteInternalId, isActive, createdAt, updatedAt"
          },
          "response": [
            {
              "name": "200 OK – Example",
              "status": "OK",
              "code": 200,
              "body": "[\n  {\n    \"id\": 1,\n    \"name\": \"Bags EU\",\n    \"parentClass\": \"Soft Goods\",\n    \"classCode\": \"Bags & Packs\",\n    \"euHtsCode\": \"4202.92\",\n    \"chinaDutyRate\": \"20.000\",\n    \"cambodiaDutyRate\": \"15.000\",\n    \"taiwanDutyRate\": \"10.000\",\n    \"thailandDutyRate\": \"12.000\",\n    \"vietnamDutyRate\": \"8.000\",\n    \"netsuiteInternalId\": \"1\",\n    \"isActive\": true,\n    \"source\": \"netsuite\",\n    \"syncStatus\": \"synced\",\n    \"createdAt\": \"2025-01-01T00:00:00.000Z\",\n    \"updatedAt\": \"2025-01-01T00:00:00.000Z\"\n  }\n]"
